-- Телепорт в игру/лобби
local function TpToGame(mode) -- coin | gem | lobby
	print(`[TDStrat - TpToGame]: Teleporting to [{mode}]...`)
	if mode == "coin" then
		dataCFG["isFarming"] = true
		UpdateCFG(dataCFG)
		RF:InvokeServer("Multiplayer","v2:start",{count = 1, mode = "hardcore"})
		
	elseif mode == "gem" then
		dataCFG["isFarming"] = true
		UpdateCFG(dataCFG)
		if Lvl.Value >= 60 then
                    RF:InvokeServer("Multiplayer","v2:start",{difficulty = "Frost", mode = "survival", count = 1})
                else
		    RF:InvokeServer("Multiplayer","v2:start",{difficulty = "Molten", mode = "survival", count = 1})
		end

